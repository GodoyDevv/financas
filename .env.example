# Configurações do Banco de Dados (Supabase / PostgreSQL)
# Se não fornecido, a aplicação utiliza SQLite local (fintrack.db)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Versão do Python em produção (Render)
PYTHON_VERSION=3.12.0

# Telefones do Casal para identificação automática no WhatsApp (DDI + DDD + Número)
WHATSAPP_USER_BRUNO=5511999999999
WHATSAPP_USER_LETICIA=5511988888888

# ID do grupo oficial do casal no WhatsApp (ex: 120363430461864097@g.us)
# Garante que mensagens de outros grupos onde o número estiver não sejam processadas
WHATSAPP_GROUP_JID=120363430461864097@g.us

# Configurações do Atlas (Secretário Executivo & Transcrição de Áudio)
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=
# Ou via OpenAI Whisper:
OPENAI_API_KEY=

# Opcional: Configurações para o Atlas responder ativamente no WhatsApp via Evolution API
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=seu_token_aqui
EVOLUTION_INSTANCE=sua_instancia
