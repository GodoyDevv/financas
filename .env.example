# Configurações do Banco de Dados (Supabase / PostgreSQL)
# Se não fornecido, a aplicação utiliza SQLite local (fintrack.db)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Versão do Python em produção (Render)
PYTHON_VERSION=3.12.0

# Telefones do Casal para identificação automática no WhatsApp (DDI + DDD + Número)
WHATSAPP_USER_BRUNO=5511999999999
WHATSAPP_USER_LETICIA=5511988888888

# Opcional: Chave de API caso utilize o assistente automatizado (builder.py)
GEMINI_API_KEY=
