# ==============================================================================
# SEGURANÇA & AUTENTICAÇÃO DO ATLAS FINANÇAS (OBRIGATÓRIO - FALHA FECHADA)
# ==============================================================================
# Senha mestre para acesso ao dashboard web (/login) e à API
APP_PASSWORD=sua_senha_forte_aqui

# Segredo criptográfico para assinatura dos cookies de sessão (mínimo 32 caracteres)
# Gere no terminal com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=gere_uma_chave_secreta_aleatoria_com_mais_de_32_caracteres_hex

# Token de autorização para endpoints administrativos (header X-Admin-Token nos relatórios)
# Gere no terminal com: python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=gere_um_token_administrativo_aleatorio_seguro

# Tempo de vida da sessão em horas (padrão: 12)
SESSION_TTL_HOURS=12

# Permitir cookies sem flag Secure apenas para testes em localhost (0 em produção, 1 apenas em dev local)
DEV_INSECURE_COOKIES=0

# ==============================================================================
# BANCO DE DADOS & INFRAESTRUTURA
# ==============================================================================
# Conexão com Supabase / PostgreSQL. Se não fornecido, utiliza SQLite local (fintrack.db)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Versão do Python em produção (Render)
PYTHON_VERSION=3.12.0

# Ambiente de execução: production desativa a documentação /docs e ativa HSTS obrigatório
ENV=production

# ==============================================================================
# SEGURANÇA DO WEBHOOK WHATSAPP (OBRIGATÓRIO - FALHA FECHADA)
# ==============================================================================
# Segredo compartilhado com a Evolution API (mínimo 32 caracteres)
# Gere no terminal com: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=gere_um_segredo_para_o_webhook_com_pelo_menos_32_caracteres

# Nome do cabeçalho HTTP esperado para autenticação do webhook (padrão: X-Webhook-Secret)
WEBHOOK_SECRET_HEADER=X-Webhook-Secret

# Permitir token no path /webhook/whatsapp/{token} (1 para ativar, 0 para apenas cabeçalho)
# Aviso: tokens em URL podem ser registrados em logs de proxies reversos e servidores intermediários
WEBHOOK_ALLOW_PATH_TOKEN=0

# ==============================================================================
# WHATSAPP & ATLAS AI AGENT (MENSAGERIA)
# ==============================================================================
# Telefones do Casal para identificação automática no WhatsApp (DDI + DDD + Número)
WHATSAPP_USER_BRUNO=5511999999999
WHATSAPP_USER_LETICIA=5511988888888

# ID do grupo oficial do casal no WhatsApp (OBRIGATÓRIO - ex: 120363000000000000@g.us)
# Sem esta variável o webhook responde 503 Service Unavailable e bloqueia qualquer ingestão
WHATSAPP_GROUP_JID=120363000000000000@g.us

# Chaves de API para Inteligência Artificial (obtenha gratuitamente em https://aistudio.google.com/)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Pipeline de Processamento de Linguagem Natural (NLP)
# hybrid (padrão): regex determinístico primeiro; Gemini estruturado apenas em caso de baixa confiança
# regex: processamento 100% determinístico local por regex (zero chamadas de API externa)
# llm: sempre consulta o Gemini se houver valor monetário, com fallback no regex
NLP_MODE=hybrid
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=8.0

# Integração Evolution API (WhatsApp Gateway)
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=seu_token_aqui
EVOLUTION_INSTANCE=sua_instancia

# Feature flag para confirmações WhatsApp
FEATURE_WA_CONFIRMATIONS=false

# Origens adicionais autorizadas para CORS (separadas por vírgula, opcional)
ALLOWED_ORIGINS=
# ==============================================================================
# OBSERVABILIDADE, LOGS & MONITORAMENTO DE ERROS (SENTRY)
# ==============================================================================
# Nível mínimo de log: DEBUG, INFO, WARNING, ERROR, CRITICAL (padrão: INFO)
LOG_LEVEL=INFO

# DSN do Sentry para monitoramento de erros e exceções (opcional)
SENTRY_DSN=

# Taxa de amostragem de performance traces (0.0 a 1.0, padrão: 0.0)
SENTRY_TRACES_SAMPLE_RATE=0.0

# Hash do commit injetado automaticamente pelo Render (RENDER_GIT_COMMIT)
RENDER_GIT_COMMIT=
