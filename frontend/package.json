{
  "name": "fintrack-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,js,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ./openapi.json -o ./src/api-types.ts"
  },
  "dependencies": {
    "chart.js": "4.4.7",
    "openapi-fetch": "0.13.4"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/node": "22.13.4",
    "eslint": "9.20.1",
    "globals": "^17.13.0",
    "jsdom": "26.0.0",
    "openapi-typescript": "7.6.1",
    "prettier": "3.5.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  }
}
